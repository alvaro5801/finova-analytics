// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

// `url` is required syntactically but ignored at runtime — the actual connection
// (local file or Turso) is controlled by the driver adapter in prisma.config.ts
// and src/lib/prisma.ts.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Convenções de valores (D1 da Quick Spec Finova):
// - Dinheiro é sempre inteiro em centavos (sufixo `Cents`). Nunca float, nunca string formatada.
// - Métricas mistas usam `value Int` + `format`:
//     "currency" -> centavos · "percent" -> pontos-base (1% = 100) · "number" -> unidades.
// - A formatação (R$, %, datas pt-BR) acontece só na UI: src/lib/format.ts.
// Os nomes dos modelos foram herdados do template original; a semântica financeira
// de cada um está documentada no comentário acima dele.

// KPIs do topo: Receita, Despesas, Saldo, Crescimento.
model StatCard {
  id          Int    @id @default(autoincrement())
  key         String @unique
  title       String
  value       Int
  format      String @default("currency")
  changePct   Float
  changeLabel String
  icon        String
  color       String
  order       Int    @default(0)
}

// Série mensal Receita × Despesas. `month` é o período "AAAA-MM".
model SalesPoint {
  id            Int    @id @default(autoincrement())
  month         String
  revenueCents  Int
  expensesCents Int
  order         Int    @default(0)
}

// Volume de transações por dia (gráfico de barras).
model ActiveUsersPoint {
  id    Int    @id @default(autoincrement())
  day   String
  value Int
  order Int    @default(0)
}

// Indicadores operacionais abaixo do gráfico de transações.
model ActiveUsersStat {
  id     Int    @id @default(autoincrement())
  label  String
  value  Int
  format String @default("number")
  icon   String
  order  Int    @default(0)
}

// Meta anual de receita: `value` é o % atingido de `targetCents`.
model SatisfactionRate {
  id          Int    @id @default(autoincrement())
  value       Float
  label       String
  targetCents Int
}

// Série auxiliar (não exibida no painel; mantida pela rota /api/referral).
model ReferralPoint {
  id     Int    @id @default(autoincrement())
  series String
  month  String
  value  Int
  order  Int    @default(0)
}

// Saúde financeira: indicadores-resumo (contas a receber, margem líquida).
model ReferralSummary {
  id        Int    @id @default(autoincrement())
  series    String @unique
  label     String
  value     Int
  format    String @default("currency")
  changePct Float
}

// Score de saúde financeira (0 a maxValue).
model ScoreRing {
  id       Int    @id @default(autoincrement())
  label    String
  value    Float
  maxValue Float  @default(10)
  caption  String
}

// Orçamentos por área. `budgetCents` nulo = orçamento não definido.
model Project {
  id          Int    @id @default(autoincrement())
  name        String
  icon        String
  members     String
  budgetCents Int?
  completion  Int
  status      String
  order       Int    @default(0)
}

// Transações recentes. `amountCents` com sinal: positivo = entrada, negativo = saída.
model OrderEvent {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  amountCents Int
  date        DateTime
  color       String
  icon        String
  order       Int      @default(0)
}

// Equipe (página Relatórios).
model Author {
  id          Int    @id @default(autoincrement())
  name        String
  email       String
  avatarColor String
  function    String
  department  String
  status      String
  employed    String
  order       Int    @default(0)
}

// Faturas da assinatura Finova (página Faturamento).
model Invoice {
  id          Int      @id @default(autoincrement())
  issuedAt    DateTime
  code        String
  amountCents Int
  order       Int      @default(0)
}
