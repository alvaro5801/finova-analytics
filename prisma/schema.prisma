// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

// `url` is required syntactically but ignored at runtime — the actual connection
// (local file or Turso) is controlled by the driver adapter in prisma.config.ts
// and src/lib/prisma.ts.
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Convenções de valores (D1 da Quick Spec Finova):
// - Dinheiro é sempre inteiro em centavos (sufixo `Cents`). Nunca float, nunca string formatada.
// - Métricas mistas usam `value Int` + `format`:
//     "currency" -> centavos · "percent" -> pontos-base (1% = 100) · "number" -> unidades.
// - A formatação (R$, %, datas pt-BR) acontece só na UI: src/lib/format.ts.
// Os nomes dos modelos foram herdados do template original; a semântica financeira
// de cada um está documentada no comentário acima dele.

// KPIs do topo: Receita, Despesas, Saldo, Crescimento.
model StatCard {
  id          Int    @id @default(autoincrement())
  key         String @unique
  title       String
  value       Int
  format      String @default("currency")
  changePct   Float
  changeLabel String
  icon        String
  color       String
  order       Int    @default(0)
}

// Série mensal Receita × Despesas. `month` é o período "AAAA-MM".
model SalesPoint {
  id            Int    @id @default(autoincrement())
  month         String
  revenueCents  Int
  expensesCents Int
  order         Int    @default(0)
}

// Volume de transações por dia (gráfico de barras).
model ActiveUsersPoint {
  id    Int    @id @default(autoincrement())
  day   String
  value Int
  order Int    @default(0)
}

// Indicadores operacionais abaixo do gráfico de transações.
model ActiveUsersStat {
  id     Int    @id @default(autoincrement())
  label  String
  value  Int
  format String @default("number")
  icon   String
  order  Int    @default(0)
}

// Meta anual de receita: `value` é o % atingido de `targetCents`.
model SatisfactionRate {
  id          Int    @id @default(autoincrement())
  value       Float
  label       String
  targetCents Int
}

// Série auxiliar (não exibida no painel; mantida pela rota /api/referral).
model ReferralPoint {
  id     Int    @id @default(autoincrement())
  series String
  month  String
  value  Int
  order  Int    @default(0)
}

// Saúde financeira: indicadores-resumo (contas a receber, margem líquida).
model ReferralSummary {
  id        Int    @id @default(autoincrement())
  series    String @unique
  label     String
  value     Int
  format    String @default("currency")
  changePct Float
}

// Score de saúde financeira (0 a maxValue).
model ScoreRing {
  id       Int    @id @default(autoincrement())
  label    String
  value    Float
  maxValue Float  @default(10)
  caption  String
}

// Orçamentos por área. `budgetCents` nulo = orçamento não definido.
model Project {
  id          Int    @id @default(autoincrement())
  name        String
  icon        String
  members     String
  budgetCents Int?
  completion  Int
  status      String
  order       Int    @default(0)
}

// Transações recentes. `amountCents` com sinal: positivo = entrada, negativo = saída.
model OrderEvent {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  amountCents Int
  date        DateTime
  color       String
  icon        String
  order       Int      @default(0)
}

// Equipe (página Relatórios).
model Author {
  id          Int    @id @default(autoincrement())
  name        String
  email       String
  avatarColor String
  function    String
  department  String
  status      String
  employed    String
  order       Int    @default(0)
}

// Faturas da assinatura Finova (página Faturamento).
model Invoice {
  id          Int      @id @default(autoincrement())
  issuedAt    DateTime
  code        String
  amountCents Int
  order       Int      @default(0)
}

// ── Integrações bancárias (Open Finance via agregador, somente leitura) ──
// Nunca guardamos senha ou credencial do banco: o usuário se autentica no próprio
// banco, dentro do widget do agregador, e recebemos só a referência da conexão (`itemId`).

// Uma conexão = um banco autorizado por um usuário.
model BankConnection {
  id                  Int           @id @default(autoincrement())
  /// Dono da conexão. Com login real, vira o id do usuário autenticado.
  userId              String
  /// "demo" | "pluggy"
  provider            String
  /// Referência da conexão no agregador (Item da Pluggy).
  itemId              String        @unique
  institutionName     String
  /// Cor da instituição em hex, sem "#".
  institutionColor    String
  /// Logo da instituição (URL do agregador); nulo nos bancos de demonstração.
  institutionImageUrl String?
  /// "connected" | "syncing" | "error" | "reconnect"
  status              String
  lastSyncAt          DateTime?
  consentExpiresAt    DateTime?
  createdAt           DateTime      @default(now())
  accounts            BankAccount[]

  @@index([userId])
}

model BankAccount {
  id                  Int               @id @default(autoincrement())
  connectionId        Int
  connection          BankConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId          String            @unique
  /// "BANK" (conta) | "CREDIT" (cartão de crédito)
  type                String
  name                String
  /// Final do número, já mascarado ("•••• 1234").
  number              String
  /// Conta: saldo. Cartão: fatura em aberto (positivo = valor devido).
  balanceCents        Int
  // Só cartões de crédito (creditData da Pluggy):
  brand               String?
  level               String?
  creditLimitCents    Int?
  availableLimitCents Int?
  billCloseDate       DateTime?
  billDueDate         DateTime?
  minimumPaymentCents Int?
  transactions        BankTransaction[]
}

// `amountCents` segue a convenção do resto do app: positivo = entrada, negativo = saída.
model BankTransaction {
  id          Int         @id @default(autoincrement())
  accountId   Int
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String      @unique
  date        DateTime
  description String
  category    String
  amountCents Int

  @@index([accountId, date])
}
